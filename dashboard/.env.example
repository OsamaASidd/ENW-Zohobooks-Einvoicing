# Cryptware NRS (FIRS) e-invoicing API credentials.
# The dashboard reuses the Zoho credentials from ../app/.env.
NRS_BASE_URL=https://preprod-api.cryptwaresystemsltd.com
NRS_API_KEY=

# Production key - only used once NRS_BASE_URL above is switched to the
# production host. Test and Production are separate Cryptware systems; do
# not mix keys/URLs across environments.
NRS_API_KEY_PROD=
