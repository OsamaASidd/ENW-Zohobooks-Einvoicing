ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ORGANIZATION_ID=

# One-time authorization code from the Zoho API Console (Self Client tab).
# Expires within minutes and can only be used once - leave blank once
# ZOHO_REFRESH_TOKEN has been populated.
ZOHO_GRANT_TOKEN=

# Populated automatically after the first successful grant-token exchange.
ZOHO_REFRESH_TOKEN=

ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
ZOHO_API_BASE=https://www.zohoapis.com/books/v3
